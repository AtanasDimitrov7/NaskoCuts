@{
    ViewData["Title"] = "Поръчката е приета";
}

<style>
    .confirm-wrap {
        max-width: 560px;
        margin: 0 auto;
        text-align: center;
        padding: 100px 20px;
    }

        .confirm-wrap .icon {
            font-size: 3.5rem;
            color: #c8a96e;
            margin-bottom: 20px;
        }

        .confirm-wrap h1 {
            font-family: 'Playfair Display', serif;
            color: #fff;
            font-size: 2.2rem;
            margin-bottom: 16px;
        }

        .confirm-wrap p {
            color: rgba(255,255,255,0.6);
            margin-bottom: 8px;
        }

    .confirm-code {
        display: inline-block;
        margin: 20px 0;
        padding: 12px 24px;
        border: 1px solid rgba(200,169,110,0.4);
        border-radius: 12px;
        font-family: monospace;
        font-size: 1.1rem;
        color: #c8a96e;
    }
</style>

<div class="confirm-wrap">
    <div class="icon"><i class="fa-solid fa-circle-check"></i></div>
    <h1>Благодарим ти, @TempData["OrderClientName"]!</h1>
    <p>Поръчката ти е приета и очаква потвърждение.</p>
    <p>Плащането е на място, при вземане от салона.</p>
    <div class="confirm-code">@TempData["OrderConfirmation"]</div>
    <p>Обща сума: <strong style="color:#c8a96e;">@TempData["OrderTotal"] лв.</strong></p>
    <div style="margin-top:30px;">
        <a href="@Url.Action("Index", "Products")" class="btn-gold">Обратно към продуктите</a>
    </div>
</div>