@model IEnumerable<NaskoCuts.Models.Entities.Appointment>
@using NaskoCuts.Models.Entities
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin — NaskoCuts</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: #0f0f0f;
            color: #e0e0e0;
            font-family: 'Segoe UI', sans-serif;
        }

        .topbar {
            background: linear-gradient(90deg, #1a1a2e, #16213e);
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

            .topbar h1 {
                font-size: 1.4rem;
                color: #fff;
                margin: 0;
            }

            .topbar span {
                color: #ff416c;
            }

        .topbar-links {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .btn-nav {
            padding: 8px 18px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.12);
            color: #ccc;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.9rem;
            transition: 0.3s;
        }

            .btn-nav:hover {
                background: rgba(255,255,255,0.12);
                color: #fff;
            }

        .btn-csv {
            padding: 8px 18px;
            background: rgba(40,200,100,0.1);
            border: 1px solid rgba(40,200,100,0.3);
            color: #4ce07a;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.9rem;
            transition: 0.3s;
        }

            .btn-csv:hover {
                background: rgba(40,200,100,0.2);
            }

        .btn-logout {
            padding: 8px 20px;
            background: rgba(255,65,108,0.15);
            border: 1px solid #ff416c;
            color: #ff416c;
            border-radius: 8px;
            text-decoration: none;
        }

            .btn-logout:hover {
                background: #ff416c;
                color: #fff;
            }

        .dashboard {
            padding: 30px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 35px;
        }

        .stat-card {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 16px;
            padding: 25px;
            text-align: center;
        }

            .stat-card .number {
                font-size: 2.5rem;
                font-weight: bold;
                color: #ff416c;
            }

            .stat-card .label {
                color: #888;
                font-size: 0.9rem;
                margin-top: 5px;
            }

        .table-wrap {
            background: #1a1a2e;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.07);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead {
            background: rgba(255,65,108,0.15);
        }

            thead th {
                padding: 15px 20px;
                text-align: left;
                font-size: 0.85rem;
                color: #ff6b8a;
                text-transform: uppercase;
            }

        tbody tr {
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }

        tbody td {
            padding: 14px 20px;
            color: #ccc;
        }

        .badge-status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
        }

        .status-pending {
            background: rgba(255,193,7,0.2);
            color: #ffc107;
        }

        .status-confirmed {
            background: rgba(40,167,69,0.2);
            color: #28a745;
        }

        .status-completed {
            background: rgba(23,162,184,0.2);
            color: #17a2b8;
        }

        .status-cancelled {
            background: rgba(220,53,69,0.2);
            color: #dc3545;
        }

        .btn-delete {
            padding: 6px 14px;
            background: rgba(255,50,50,0.1);
            border: 1px solid rgba(255,50,50,0.4);
            color: #ff6b6b;
            border-radius: 8px;
            cursor: pointer;
        }

        .section-title {
            font-size: 1.2rem;
            color: #fff;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
    </style>
</head>
<body>
    <div class="topbar">
        <h1>✂️ NaskoCuts <span>Admin</span></h1>
        <div class="topbar-links">
            <a href="@Url.Action("Statistics", "Admin")" class="btn-nav">Статистики</a>
            <a href="@Url.Action("ManageServices", "Admin")" class="btn-nav">Услуги</a>
            <a href="@Url.Action("ManageBarbers", "Admin")" class="btn-nav">Бръснари</a>
            <a href="@Url.Action("ExportCsv", "Admin")" class="btn-csv">CSV</a>
            <a href="@Url.Action("Logout", "Admin")" class="btn-logout">Изход</a>
        </div>
    </div>

    <div class="dashboard">
        <div class="stats">
            <div class="stat-card">
                <div class="number">@Model.Count()</div>
                <div class="label">Общо резервации</div>
            </div>
            <div class="stat-card">
                <div class="number">@Model.Count(a => a.Status == AppointmentStatus.Pending)</div>
                <div class="label">Чакащи</div>
            </div>
            <div class="stat-card">
                <div class="number">@Model.Count(a => a.AppointmentDate.Date == DateTime.Today)</div>
                <div class="label">Днес</div>
            </div>
            <div class="stat-card">
                <div class="number">@Model.Count(a => a.Status == AppointmentStatus.Completed)</div>
                <div class="label">Завършени</div>
            </div>
        </div>

        <div class="section-title">Всички резервации</div>

        <div class="table-wrap">
            @if (!Model.Any())
            {
                <p style="padding:40px;text-align:center;color:#555">Все още няма резервации.</p>
            }
            else
            {
                <table>
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Клиент</th>
                            <th>Email</th>
                            <th>Телефон</th>
                            <th>Услуга</th>
                            <th>Бръснар</th>
                            <th>Дата</th>
                            <th>Статус</th>
                            <th>Код</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>@a.Id</td>
                                <td><strong style="color:#fff">@a.ClientName</strong></td>
                                <td>@a.ClientEmail</td>
                                <td>@a.ClientPhone</td>
                                <td>@a.Service?.Name</td>
                                <td>@a.Barber?.FullName</td>
                                <td>@a.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <span class="badge-status status-@a.Status.ToString().ToLower()">
                                        @a.Status
                                    </span>
                                </td>
                                <td style="font-family:monospace;font-size:0.8rem">@a.ConfirmationCode</td>
                                <td>
                                    <form method="post" action="@Url.Action("Delete", "Admin")" onsubmit="return confirm('Изтрий?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@a.Id" />
                                        <button type="submit" class="btn-delete">Изтрий</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</body>
</html>