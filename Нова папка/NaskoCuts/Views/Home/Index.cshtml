@{
    ViewData["Title"] = "Home";
}

<style>
    /* ─── HERO ─────────────────────────────────── */
    .hero {
        height: 100vh;
        min-height: 700px;
        position: relative;
        display: flex;
        align-items: center;
        overflow: hidden;
        background: #060606;
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        background: url('https://images.unsplash.com/photo-1585747860715-2ba37e788b70?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
        opacity: 0.18;
        animation: heroZoom 20s ease-in-out infinite alternate;
    }

    @@keyframes heroZoom {
        from {
            transform: scale(1.07);
        }

        to {
            transform: scale(1.00);
        }
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(110deg, rgba(6,6,6,0.97) 40%, rgba(6,6,6,0.5) 100%);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        padding-top: 80px;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        color: #c8a96e;
        letter-spacing: 5px;
        text-transform: uppercase;
        font-size: 0.75rem;
        font-weight: 600;
        margin-bottom: 24px;
        animation: fadeUp 0.7s ease both;
    }

        .hero-eyebrow::before,
        .hero-eyebrow::after {
            content: '';
            width: 35px;
            height: 1px;
            background: #c8a96e;
            opacity: 0.6;
        }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(3.2rem, 7vw, 6rem);
        line-height: 1.08;
        margin-bottom: 26px;
        animation: fadeUp 0.8s 0.12s ease both;
    }

        .hero-title .gold {
            color: #c8a96e;
        }

    .hero-desc {
        color: #888;
        font-size: 1.05rem;
        line-height: 1.95;
        max-width: 480px;
        margin-bottom: 42px;
        animation: fadeUp 0.8s 0.24s ease both;
    }

    .hero-btns {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        animation: fadeUp 0.8s 0.36s ease both;
    }

    .btn-outline-hero {
        background: transparent;
        color: rgba(255,255,255,0.8);
        font-weight: 600;
        padding: 14px 34px;
        border-radius: 50px;
        text-decoration: none;
        font-size: 0.85rem;
        border: 1px solid rgba(255,255,255,0.18);
        transition: 0.3s;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .btn-outline-hero:hover {
            border-color: #c8a96e;
            color: #c8a96e;
        }

    .hero-float-badge {
        position: absolute;
        right: 9%;
        top: 50%;
        transform: translateY(-50%);
        width: 155px;
        height: 155px;
        border: 1px solid rgba(200,169,110,0.35);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
        animation: rotateBadge 28s linear infinite;
    }

    .hero-float-badge-inner {
        animation: rotateBadgeReverse 28s linear infinite;
        text-align: center;
    }

    @@keyframes rotateBadge {
        to {
            transform: translateY(-50%) rotate(360deg);
        }
    }

    @@keyframes rotateBadgeReverse {
        to {
            transform: rotate(-360deg);
        }
    }

    .hero-float-badge .b-num {
        font-family: 'Playfair Display',serif;
        font-size: 2.4rem;
        color: #c8a96e;
        line-height: 1;
        display: block;
    }

    .hero-float-badge .b-lbl {
        font-size: 0.62rem;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-top: 5px;
        display: block;
    }

    .scroll-down {
        position: absolute;
        bottom: 38px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        color: #c8a96e;
        font-size: 1.1rem;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        animation: bounceDown 2.5s infinite;
    }

        .scroll-down span {
            font-size: 0.65rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #555;
        }

    @@keyframes bounceDown {
        0%, 100% {
            transform: translateX(-50%) translateY(0);
        }

        50% {
            transform: translateX(-50%) translateY(-9px);
        }
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(32px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ─── STATS ─────────────────────────────────── */
    .stats-section {
        background: #0e0e0e;
        padding: 70px 0;
        border-top: 1px solid #161616;
        border-bottom: 1px solid #161616;
    }

    .stat-box {
        text-align: center;
        padding: 15px 20px;
    }

    .stat-num {
        font-family: 'Playfair Display', serif;
        font-size: 3.4rem;
        color: #c8a96e;
        line-height: 1;
        font-weight: 700;
    }

    .stat-lbl {
        color: #444;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 3px;
        margin-top: 9px;
    }

    .stat-sep {
        width: 1px;
        height: 70px;
        background: #1a1a1a;
        align-self: center;
    }

    /* ─── SERVICES ───────────────────────────────── */
    .services-section {
        padding: 115px 0;
        background: #0a0a0a;
    }

    .svc-card {
        background: #101010;
        border: 1px solid #181818;
        border-radius: 22px;
        overflow: hidden;
        transition: all 0.4s ease;
        height: 100%;
    }

        .svc-card:hover {
            border-color: rgba(200,169,110,0.5);
            transform: translateY(-12px);
            box-shadow: 0 25px 70px rgba(0,0,0,0.6);
        }

    .svc-img {
        height: 215px;
        overflow: hidden;
        position: relative;
    }

        .svc-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.6s ease;
            display: block;
        }

    .svc-card:hover .svc-img img {
        transform: scale(1.1);
    }

    .svc-tag {
        position: absolute;
        top: 15px;
        right: 15px;
        background: rgba(200,169,110,0.9);
        color: #0a0a0a;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 5px 13px;
        border-radius: 50px;
    }

    .svc-body {
        padding: 26px;
    }

        .svc-body h4 {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            color: #fff;
            margin-bottom: 9px;
        }

        .svc-body p {
            color: #555;
            font-size: 0.86rem;
            line-height: 1.7;
            margin-bottom: 22px;
        }

    .svc-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #181818;
        padding-top: 16px;
    }

    .svc-price {
        font-family: 'Playfair Display', serif;
        font-size: 1.5rem;
        color: #c8a96e;
    }

    .svc-dur {
        color: #3a3a3a;
        font-size: 0.76rem;
        margin-top: 3px;
    }

        .svc-dur i {
            color: #c8a96e;
            margin-right: 4px;
        }

    .btn-svc {
        border: 1px solid rgba(200,169,110,0.4);
        color: #c8a96e;
        padding: 8px 20px;
        border-radius: 50px;
        font-size: 0.77rem;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
        letter-spacing: 0.3px;
    }

        .btn-svc:hover {
            background: #c8a96e;
            color: #0a0a0a;
            border-color: #c8a96e;
        }

    /* ─── ABOUT ──────────────────────────────────── */
    .about-section {
        padding: 115px 0;
        background: #0d0d0d;
    }

    .about-img-wrap {
        position: relative;
    }

    .about-img-main {
        width: 100%;
        height: 510px;
        object-fit: cover;
        border-radius: 22px;
        display: block;
    }

    .about-badge {
        position: absolute;
        bottom: -22px;
        right: -22px;
        background: linear-gradient(135deg, #c8a96e, #e8c97e);
        color: #0a0a0a;
        border-radius: 18px;
        padding: 22px 26px;
        text-align: center;
        box-shadow: 0 15px 40px rgba(200,169,110,0.4);
    }

        .about-badge .big {
            font-size: 2.4rem;
            font-weight: 800;
            line-height: 1;
            display: block;
        }

        .about-badge .small {
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-weight: 600;
            margin-top: 4px;
            display: block;
        }

    .about-body .lead-text {
        color: #666;
        line-height: 1.95;
        margin-bottom: 15px;
        font-size: 0.93rem;
    }

    .about-features {
        list-style: none;
        padding: 0;
        margin: 26px 0 34px;
    }

        .about-features li {
            padding: 12px 0;
            color: #bbb;
            border-bottom: 1px solid #161616;
            display: flex;
            align-items: center;
            gap: 13px;
            font-size: 0.9rem;
        }

            .about-features li:last-child {
                border-bottom: none;
            }

            .about-features li i {
                color: #c8a96e;
                font-size: 0.9rem;
            }

    /* ─── WHY US ─────────────────────────────────── */
    .whyus-section {
        padding: 115px 0;
        background: #080808;
    }

    .whyus-card {
        background: #0f0f0f;
        border: 1px solid #181818;
        border-radius: 20px;
        padding: 38px 26px;
        text-align: center;
        transition: 0.35s;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

        .whyus-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #c8a96e, #e8c97e);
            transform: scaleX(0);
            transition: 0.35s;
            transform-origin: left;
        }

        .whyus-card:hover {
            border-color: rgba(200,169,110,0.25);
            transform: translateY(-7px);
        }

            .whyus-card:hover::before {
                transform: scaleX(1);
            }

    .whyus-icon {
        width: 70px;
        height: 70px;
        background: rgba(200,169,110,0.07);
        border: 1px solid rgba(200,169,110,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 22px;
        font-size: 1.5rem;
        color: #c8a96e;
        transition: 0.3s;
    }

    .whyus-card:hover .whyus-icon {
        background: rgba(200,169,110,0.15);
    }

    .whyus-card h5 {
        color: #fff;
        font-weight: 600;
        margin-bottom: 13px;
        font-size: 1rem;
    }

    .whyus-card p {
        color: #484848;
        font-size: 0.86rem;
        line-height: 1.8;
        margin: 0;
    }

    /* ─── BARBERS ────────────────────────────────── */
    .barbers-section {
        padding: 115px 0;
        background: #0a0a0a;
    }

    .barber-card {
        border-radius: 20px;
        overflow: hidden;
        position: relative;
        cursor: pointer;
        background: #111;
    }

        .barber-card img {
            width: 100%;
            height: 380px;
            object-fit: cover;
            transition: 0.55s;
            filter: grayscale(25%);
            display: block;
        }

        .barber-card:hover img {
            transform: scale(1.07);
            filter: grayscale(0%);
        }

    .barber-info {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.96) 50%, transparent);
        padding: 35px 22px 22px;
        transform: translateY(58px);
        transition: 0.45s ease;
    }

    .barber-card:hover .barber-info {
        transform: translateY(0);
    }

    .barber-info h5 {
        font-family: 'Playfair Display', serif;
        font-size: 1.2rem;
        margin-bottom: 5px;
    }

    .barber-info .role {
        color: #c8a96e;
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .barber-social {
        margin-top: 14px;
        display: flex;
        gap: 8px;
    }

        .barber-social a {
            width: 34px;
            height: 34px;
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.5);
            font-size: 0.78rem;
            transition: 0.3s;
            text-decoration: none;
        }

            .barber-social a:hover {
                border-color: #c8a96e;
                color: #c8a96e;
            }

    /* ─── TESTIMONIALS ───────────────────────────── */
    .testimonials-section {
        padding: 115px 0;
        background: #0d0d0d;
    }

    .testi-card {
        background: #0a0a0a;
        border: 1px solid #181818;
        border-radius: 22px;
        padding: 38px;
        height: 100%;
        transition: 0.35s;
        position: relative;
    }

        .testi-card::before {
            content: '\201C';
            position: absolute;
            top: 22px;
            right: 28px;
            font-size: 6rem;
            color: #c8a96e;
            opacity: 0.1;
            font-family: 'Playfair Display', serif;
            line-height: 1;
        }

        .testi-card:hover {
            border-color: rgba(200,169,110,0.3);
            box-shadow: 0 15px 50px rgba(0,0,0,0.4);
        }

    .stars {
        color: #c8a96e;
        letter-spacing: 3px;
        margin-bottom: 18px;
        font-size: 0.85rem;
    }

    .testi-text {
        color: #888;
        font-style: italic;
        line-height: 1.85;
        font-size: 0.9rem;
        margin-bottom: 28px;
    }

    .testi-author {
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .testi-author img {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #c8a96e;
        }

        .testi-author .name {
            color: #fff;
            font-weight: 600;
            font-size: 0.88rem;
        }

        .testi-author .when {
            color: #333;
            font-size: 0.76rem;
            margin-top: 2px;
        }

    /* ─── GALLERY ────────────────────────────────── */
    .gallery-section {
        padding: 115px 0;
        background: #060606;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: repeat(2, 210px);
        gap: 10px;
    }

    .gal-item {
        overflow: hidden;
        border-radius: 14px;
        cursor: pointer;
        position: relative;
    }

        .gal-item:first-child {
            grid-column: span 2;
            grid-row: span 2;
        }

        .gal-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.55s;
            display: block;
        }

        .gal-item:hover img {
            transform: scale(1.1);
        }

    .gal-overlay {
        position: absolute;
        inset: 0;
        background: rgba(200,169,110,0);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.35s;
    }

        .gal-overlay i {
            color: #fff;
            font-size: 2rem;
            opacity: 0;
            transition: 0.35s;
        }

    .gal-item:hover .gal-overlay {
        background: rgba(200,169,110,0.28);
    }

        .gal-item:hover .gal-overlay i {
            opacity: 1;
        }

    /* ─── CTA ────────────────────────────────────── */
    .cta-section {
        padding: 120px 0;
        background: radial-gradient(ellipse at center, #1a1208 0%, #0a0a0a 70%);
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .cta-deco {
        position: absolute;
        font-size: 24rem;
        color: #c8a96e;
        opacity: 0.025;
        top: 50%;
        transform: translateY(-50%);
        font-family: 'Playfair Display', serif;
        user-select: none;
    }

        .cta-deco.left {
            left: -6%;
        }

        .cta-deco.right {
            right: -6%;
            transform: translateY(-50%) scaleX(-1);
        }

    .cta-content {
        position: relative;
        z-index: 2;
    }

    .cta-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2.2rem, 4vw, 3.2rem);
        margin-bottom: 18px;
    }

    .cta-sub {
        color: #666;
        font-size: 1rem;
        margin-bottom: 44px;
    }

    /* ─── CONTACT ────────────────────────────────── */
    .contact-section {
        padding: 115px 0;
        background: #0a0a0a;
    }

    .contact-card {
        background: #0e0e0e;
        border: 1px solid #181818;
        border-radius: 22px;
        padding: 42px;
        height: 100%;
    }

    .ci {
        display: flex;
        align-items: flex-start;
        gap: 18px;
        margin-bottom: 30px;
    }

    .ci-icon {
        width: 48px;
        height: 48px;
        background: rgba(200,169,110,0.07);
        border: 1px solid rgba(200,169,110,0.18);
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #c8a96e;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .ci h6 {
        color: #c8a96e;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 2.5px;
        margin-bottom: 6px;
        font-weight: 600;
    }

    .ci p {
        color: #888;
        font-size: 0.9rem;
        margin: 0;
        line-height: 1.6;
    }

    .hours-tbl {
        width: 100%;
        border-collapse: collapse;
    }

        .hours-tbl td {
            padding: 11px 0;
            font-size: 0.86rem;
            border-bottom: 1px solid #141414;
            color: #666;
        }

            .hours-tbl td:last-child {
                text-align: right;
                color: #c8a96e;
            }

        .hours-tbl tr.today td {
            color: #ccc;
        }

            .hours-tbl tr.today td:last-child {
                color: #c8a96e;
                font-weight: 600;
            }

    .map-wrap {
        border-radius: 22px;
        overflow: hidden;
        height: 100%;
        min-height: 400px;
        border: 1px solid #181818;
    }

        .map-wrap iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
            filter: invert(90%) hue-rotate(180deg) brightness(0.85);
        }
</style>

<!-- ═══════════════ HERO ═══════════════ -->
<section class="hero" id="home">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>

    <div class="container">
        <div class="row">
            <div class="col-lg-7">
                <div class="hero-content">
                    <div class="hero-eyebrow">Sofia's Premier Barbershop</div>
                    <h1 class="hero-title">
                        Look Sharp.<br>
                        Feel <span class="gold">Premium.</span>
                    </h1>
                    <p class="hero-desc">
                        Expert barbers. Precision cuts. An experience you'll come back to.
                        Walk in looking good — walk out looking legendary.
                    </p>
                    <div class="hero-btns">
                        <a href="@Url.Action("BookAppointment", "Home")" class="btn-gold">Book Appointment</a>
                        <a href="#services" class="btn-outline-hero">View Services</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="hero-float-badge d-none d-xl-flex">
        <div class="hero-float-badge-inner">
            <span class="b-num">10+</span>
            <span class="b-lbl">Years of<br>Excellence</span>
        </div>
    </div>

    <a href="#stats" class="scroll-down">
        <i class="fas fa-chevron-down"></i>
        <span>Scroll</span>
    </a>
</section>

<!-- ═══════════════ STATS ═══════════════ -->
<section class="stats-section" id="stats">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="0">
                <div class="stat-box">
                    <div class="stat-num" data-count="5000">0</div>
                    <div class="stat-lbl">Happy Clients</div>
                </div>
            </div>
            <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="120">
                <div class="stat-box">
                    <div class="stat-num" data-count="10">0</div>
                    <div class="stat-lbl">Years Experience</div>
                </div>
            </div>
            <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="240">
                <div class="stat-box">
                    <div class="stat-num" data-count="8">0</div>
                    <div class="stat-lbl">Expert Barbers</div>
                </div>
            </div>
            <div class="col-6 col-md-3" data-aos="fade-up" data-aos-delay="360">
                <div class="stat-box">
                    <div class="stat-num" data-count="12">0</div>
                    <div class="stat-lbl">Premium Services</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════ SERVICES ═══════════════ -->
<section class="services-section" id="services">
    <div class="container">
        <div data-aos="fade-up">
            <div class="section-subtitle">What We Offer</div>
            <h2 class="section-title">Our Services</h2>
            <div class="gold-divider"></div>
        </div>
        <div class="row g-4 mt-4">
            @foreach (var s in (ViewBag.Services as IEnumerable<NaskoCuts.Models.Entities.Service>)!)
            {
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="0">
                    <div class="svc-card">
                        <div class="svc-img">
