@model IEnumerable<NaskoCuts.Models.Entities.Service>
@{
    ViewData["Title"] = "Services";
}

<style>
    .services-hero {
        text-align: center;
        padding: 60px 20px 40px;
    }

        .services-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: 1px;
            margin-bottom: 15px;
            text-shadow: 0 0 30px rgba(200,169,110,0.5);
        }

            .services-hero h1 i {
                color: #c8a96e;
                font-size: 0.8em;
                margin-right: 12px;
                vertical-align: middle;
            }

        .services-hero p {
            font-size: 1.1rem;
            color: rgba(255,255,255,0.7);
            max-width: 500px;
            margin: 0 auto;
        }

    .search-bar-wrap {
        max-width: 480px;
        margin: 0 auto 30px;
        position: relative;
    }

        .search-bar-wrap input {
            width: 100%;
            padding: 14px 20px 14px 46px;
            border-radius: 50px;
            border: 1px solid rgba(200,169,110,0.3);
            background: rgba(255,255,255,0.06);
            color: #fff;
            font-size: 0.95rem;
            outline: none;
            transition: 0.3s;
        }

            .search-bar-wrap input:focus {
                border-color: #c8a96e;
                background: rgba(200,169,110,0.06);
            }

            .search-bar-wrap input::placeholder {
                color: rgba(255,255,255,0.35);
            }

        .search-bar-wrap i {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #c8a96e;
        }

    .no-results {
        text-align: center;
        color: rgba(255,255,255,0.4);
        padding: 40px 0;
        display: none;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        padding: 20px 0 60px;
    }

    .service-card {
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 20px;
        overflow: hidden;
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        }

    .service-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
    }

    .service-img-placeholder {
        width: 100%;
        height: 200px;
        background: linear-gradient(135deg, #c8a96e, #e8c97e);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
    }

    .service-body {
        padding: 25px;
    }

        .service-body h3 {
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 10px;
            color: #fff;
        }

        .service-body p {
            color: rgba(255,255,255,0.65);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 20px;
        }

    .service-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .service-price {
        font-size: 1.3rem;
        font-weight: 800;
        color: #c8a96e;
    }

        .service-price span {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.4);
            font-weight: 400;
        }

    .service-duration {
        background: rgba(200,169,110,0.15);
        border: 1px solid rgba(200,169,110,0.3);
        color: #c8a96e;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
    }

    .book-btn {
        display: block;
        text-align: center;
        padding: 12px;
        background: linear-gradient(45deg, #c8a96e, #e8c97e);
        color: #0a0a0a;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.3s;
    }

        .book-btn:hover {
            transform: scale(1.03);
            box-shadow: 0 8px 25px rgba(200,169,110,0.5);
            color: #0a0a0a;
        }

    .cta-section {
        text-align: center;
        padding: 50px 20px;
        background: rgba(255,255,255,0.05);
        border-radius: 20px;
        margin-bottom: 40px;
        border: 1px solid rgba(255,255,255,0.1);
    }

        .cta-section h2 {
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .cta-section p {
            color: rgba(255,255,255,0.7);
            margin-bottom: 25px;
        }
</style>

<div class="services-hero">
    <h1><i class="fa-solid fa-scissors"></i> Our Services</h1>
    <p>Choose a service and book your appointment online in minutes.</p>
</div>

<div class="search-bar-wrap">
    <i class="fas fa-search"></i>
    <input type="text" id="serviceSearch" placeholder="Search services by name..." />
</div>

<div class="services-grid" id="servicesGrid">
    @foreach (var s in Model)
    {
        <div class="service-card" data-name="@s.Name.ToLower()">
            @if (!string.IsNullOrEmpty(s.ImageUrl))
            {
                <img class="service-img" src="@s.ImageUrl" alt="@s.Name" />
            }
            else
            {
                <div class="service-img-placeholder">✂️</div>
            }
            <div class="service-body">
                <h3>@s.Name</h3>
                <p>@s.Description</p>
                <div class="service-meta">
                    <div class="service-price">@((s.Price / 1.95583m).ToString("0.00")) € <span>/ service</span></div>
                    <div class="service-duration">@s.DurationMinutes min</div>
                </div>
                <a href="@Url.Action("BookAppointment", "Home")" class="book-btn">Book Now</a>
            </div>
        </div>
    }
</div>

<p class="no-results" id="noResults">No services found.</p>

<div class="cta-section">
    <h2>Ready for a new look?</h2>
    <p>Book your appointment now and get expert treatment from our team.</p>
    <a href="@Url.Action("BookAppointment", "Home")" class="btn-gold">Book Now</a>
</div>

<script>
    (function () {
        var input = document.getElementById('serviceSearch');
        var cards = document.querySelectorAll('#servicesGrid .service-card');
        var noResults = document.getElementById('noResults');

        input.addEventListener('input', function () {
            var query = input.value.trim().toLowerCase();
            var visibleCount = 0;

            cards.forEach(function (card) {
                var name = card.getAttribute('data-name') || '';
                var matches = name.indexOf(query) !== -1;
                card.style.display = matches ? '' : 'none';
                if (matches) visibleCount++;
            });

            noResults.style.display = visibleCount === 0 ? 'block' : 'none';
        });
    })();
</script>