@{
    ViewData["Title"] = "Book Appointment";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - NaskoCuts</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        /* === GLOBAL STYLES === */
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(120deg, #1e3c72, #2a5298);
            color: #fff;
            overflow-x: hidden;
        }

        h1 {
            text-align: center;
            font-size: 3rem;
            margin-bottom: 40px;
            animation: fadeInUp 1s ease forwards;
            opacity: 0;
        }

        /* === CONTAINER === */
        .container {
            max-width: 700px;
            margin: 80px auto;
            padding: 40px;
            background: rgba(255,255,255,0.05);
            border-radius: 25px;
            backdrop-filter: blur(15px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            animation: fadeInUp 1.2s ease forwards;
            opacity: 0;
        }

        /* === FORM ELEMENTS === */
        form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        input, select, textarea {
            padding: 15px 20px;
            border-radius: 15px;
            border: none;
            font-size: 1rem;
            background: rgba(255,255,255,0.1);
            color: #fff;
            outline: none;
            transition: 0.3s;
        }

            input:focus, select:focus, textarea:focus {
                background: rgba(255,255,255,0.2);
                box-shadow: 0 0 10px #ff416c;
            }

        button {
            padding: 15px 30px;
            font-size: 1.2rem;
            font-weight: bold;
            color: #fff;
            background: linear-gradient(45deg, #ff416c, #ff4b2b);
            border: none;
            border-radius: 50px;
            cursor: pointer;
            transition: transform 0.3s, box-shadow 0.3s;
        }

            button:hover {
                transform: scale(1.05);
                box-shadow: 0 0 20px #ff4b2b;
            }

        /* === FLOATING SHAPES === */
        .floating-shape {
            position: absolute;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255,255,255,0.15);
            animation: float 6s infinite ease-in-out;
        }

            .floating-shape:nth-child(1) {
                left: 5%;
                top: 10%;
                animation-delay: 0s;
            }

            .floating-shape:nth-child(2) {
                right: 10%;
                top: 20%;
                animation-delay: 2s;
            }

            .floating-shape:nth-child(3) {
                left: 40%;
                top: 5%;
                animation-delay: 4s;
            }

        /* === ANIMATIONS === */
        @@keyframes fadeInUp {
            0%

        {
            opacity: 0;
            transform: translateY(50px);
        }

        100% {
            opacity: 1;
            transform: translateY(0);
        }

        }

        @@keyframes float {
            0%, 100%

        {
            transform: translateY(0) rotate(0deg);
        }

        50% {
            transform: translateY(-30px) rotate(180deg);
        }

        }
    </style>
</head>
<body>

    <div class="container">
        <h1>Book Your Appointment ✂️</h1>
        <form method="post" action="@Url.Action("BookAppointment", "Home")">
            <input type="text" name="name" placeholder="Full Name" required />
            <input type="email" name="email" placeholder="Email Address" required />
            <input type="tel" name="phone" placeholder="Phone Number" required />
            <select name="service" required>
                <option value="" disabled selected>Select Service</option>
                <option value="Classic Fade">Classic Fade</option>
                <option value="Undercut">Undercut</option>
                <option value="Pompadour">Pompadour</option>
                <option value="Buzz Cut">Buzz Cut</option>
            </select>
            <input type="date" name="date" required />
            <input type="time" name="time" required />
            <textarea name="notes" placeholder="Additional Notes (Optional)"></textarea>
            <button type="submit">Book Now</button>
        </form>
    </div>

    <!-- Floating Shapes -->
    <div class="floating-shape"></div>
    <div class="floating-shape"></div>
    <div class="floating-shape"></div>

</body>
</html>
