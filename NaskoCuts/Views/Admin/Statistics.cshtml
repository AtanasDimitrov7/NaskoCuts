@{
    ViewData["Title"] = "Статистики";
    Layout = null;
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Статистики — Admin NaskoCuts</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body {
            background: #0f0f0f;
            color: #e0e0e0;
            font-family: 'Segoe UI', sans-serif;
        }

        .topbar {
            background: linear-gradient(90deg, #1a1a2e, #16213e);
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

            .topbar h1 {
                font-size: 1.4rem;
                color: #fff;
                margin: 0;
            }

            .topbar span {
                color: #ff416c;
            }

        .topbar-links {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .btn-nav {
            padding: 8px 18px;
            background: rgba(255,255,255,0.07);
            border: 1px solid rgba(255,255,255,0.12);
            color: #ccc;
            border-radius: 8px;
            text-decoration: none;
            font-size: 0.9rem;
        }

            .btn-nav:hover {
                background: rgba(255,255,255,0.12);
                color: #fff;
            }

        .btn-logout {
            padding: 8px 20px;
            background: rgba(255,65,108,0.15);
            border: 1px solid #ff416c;
            color: #ff416c;
            border-radius: 8px;
            text-decoration: none;
        }

        .dashboard {
            padding: 30px;
        }

        .page-title {
            font-size: 1.5rem;
            color: #fff;
            margin-bottom: 25px;
            font-weight: 700;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: linear-gradient(135deg, #1a1a2e, #16213e);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 16px;
            padding: 25px;
            text-align: center;
        }

            .stat-card .number {
                font-size: 2.5rem;
                font-weight: bold;
            }

            .stat-card .label {
                color: #888;
                font-size: 0.9rem;
                margin-top: 5px;
            }

        .color-total {
            color: #ff416c;
        }

        .color-pending {
            color: #ffc107;
        }

        .color-confirmed {
            color: #28a745;
        }

        .color-completed {
            color: #17a2b8;
        }

        .color-cancelled {
            color: #dc3545;
        }

        .color-revenue {
            color: #ffd700;
        }

        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
            margin-bottom: 40px;
        }

        @@media (max-width: 768px) {
            .two-col {
                grid-template-columns: 1fr;
            }
        }

        .list-card {
            background: #1a1a2e;
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 16px;
            padding: 25px;
        }

            .list-card h3 {
                font-size: 1rem;
                color: #ff6b8a;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                margin-bottom: 20px;
                padding-bottom: 10px;
                border-bottom: 1px solid rgba(255,255,255,0.08);
            }

        .list-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.04);
        }

            .list-item:last-child {
                border-bottom: none;
            }

            .list-item .name {
                color: #fff;
                font-weight: 500;
            }

            .list-item .count {
                background: rgba(255,65,108,0.15);
                color: #ff6b8a;
                padding: 4px 14px;
                border-radius: 20px;
                font-size: 0.85rem;
                font-weight: 600;
            }

        .bar-wrap {
            margin-top: 6px;
            background: rgba(255,255,255,0.07);
            border-radius: 10px;
            height: 6px;
            width: 100%;
        }

        .bar-fill {
            height: 6px;
            border-radius: 10px;
            background: linear-gradient(90deg, #ff416c, #ff4b2b);
        }
    </style>
</head>
<body>
    <div class="topbar">
        <h1>✂️ NaskoCuts <span>Admin</span></h1>
        <div class="topbar-links">
            <a href="@Url.Action("Index", "Admin")" class="btn-nav">Резервации</a>
            <a href="@Url.Action("ManageServices", "Admin")" class="btn-nav">Услуги</a>
            <a href="@Url.Action("ManageBarbers", "Admin")" class="btn-nav">Бръснари</a>
            <a href="@Url.Action("Logout", "Admin")" class="btn-logout">Изход</a>
        </div>
    </div>

    <div class="dashboard">
        <div class="page-title">📊 Статистики</div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="number color-total">@ViewBag.Total</div>
                <div class="label">Общо резервации</div>
            </div>
            <div class="stat-card">
                <div class="number color-pending">@ViewBag.Pending</div>
                <div class="label">Чакащи</div>
            </div>
            <div class="stat-card">
                <div class="number color-confirmed">@ViewBag.Confirmed</div>
                <div class="label">Потвърдени</div>
            </div>
            <div class="stat-card">
                <div class="number color-completed">@ViewBag.Completed</div>
                <div class="label">Завършени</div>
            </div>
            <div class="stat-card">
                <div class="number color-cancelled">@ViewBag.Cancelled</div>
                <div class="label">Отказани</div>
            </div>
            <div class="stat-card">
                <div class="number color-revenue">@ViewBag.Revenue лв.</div>
                <div class="label">Общ приход</div>
            </div>
        </div>

        <div class="two-col">
            <div class="list-card">
                <h3>Топ услуги</h3>
                @if (ViewBag.TopServices != null)
                {
                    int maxServices = 0;
                    foreach (var s in ViewBag.TopServices) { if (s.Count > maxServices) maxServices = s.Count; }

                    foreach (var s in ViewBag.TopServices)
                    {
                        int pct = maxServices > 0 ? (int)(s.Count * 100 / maxServices) : 0;
                        <div class="list-item">
                            <div>
                                <div class="name">@s.Name</div>
                                <div class="bar-wrap"><div class="bar-fill" style="width:@pct%"></div></div>
                            </div>
                            <div class="count">@s.Count</div>
                        </div>
                    }
                }
            </div>

            <div class="list-card">
                <h3>Топ бръснари</h3>
                @if (ViewBag.TopBarbers != null)
                {
                    int maxBarbers = 0;
                    foreach (var b in ViewBag.TopBarbers) { if (b.Count > maxBarbers) maxBarbers = b.Count; }

                    foreach (var b in ViewBag.TopBarbers)
                    {
                        int pct = maxBarbers > 0 ? (int)(b.Count * 100 / maxBarbers) : 0;
                        <div class="list-item">
                            <div>
                                <div class="name">@b.Name</div>
                                <div class="bar-wrap"><div class="bar-fill" style="width:@pct%"></div></div>
                            </div>
                            <div class="count">@b.Count</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</body>
</html>