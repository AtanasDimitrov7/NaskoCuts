@model IEnumerable<NaskoCuts.Models.Entities.Service>
@{
    ViewData["Title"] = "Услуги";
}

<style>
    .services-hero {
        text-align: center;
        padding: 60px 20px 40px;
    }

        .services-hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            font-weight: 800;
            color: #fff;
            letter-spacing: 1px;
            margin-bottom: 15px;
            text-shadow: 0 0 30px rgba(200,169,110,0.5);
        }

            .services-hero h1 i {
                color: #c8a96e;
                font-size: 0.8em;
                margin-right: 12px;
                vertical-align: middle;
            }

        .services-hero p {
            font-size: 1.1rem;
            color: rgba(255,255,255,0.7);
            max-width: 500px;
            margin: 0 auto;
        }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        padding: 20px 0 60px;
    }

    .service-card {
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 20px;
        overflow: hidden;
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.3);
        }

    .service-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
    }

    .service-img-placeholder {
        width: 100%;
        height: 200px;
        background: linear-gradient(135deg, #c8a96e, #e8c97e);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
    }

    .service-body {
        padding: 25px;
    }

        .service-body h3 {
            font-size: 1.3rem;
            font-weight: 700;
            margin-bottom: 10px;
            color: #fff;
        }

        .service-body p {
            color: rgba(255,255,255,0.65);
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 20px;
        }

    .service-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .service-price {
        font-size: 1.8rem;
        font-weight: 800;
        color: #c8a96e;
    }

        .service-price span {
            font-size: 0.9rem;
            color: rgba(255,255,255,0.4);
            font-weight: 400;
        }

    .service-duration {
        background: rgba(200,169,110,0.15);
        border: 1px solid rgba(200,169,110,0.3);
        color: #c8a96e;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
    }

    .book-btn {
        display: block;
        text-align: center;
        padding: 12px;
        background: linear-gradient(45deg, #c8a96e, #e8c97e);
        color: #0a0a0a;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.3s;
    }

        .book-btn:hover {
            transform: scale(1.03);
            box-shadow: 0 8px 25px rgba(200,169,110,0.5);
            color: #0a0a0a;
        }

    .cta-section {
        text-align: center;
        padding: 50px 20px;
        background: rgba(255,255,255,0.05);
        border-radius: 20px;
        margin-bottom: 40px;
        border: 1px solid rgba(255,255,255,0.1);
    }

        .cta-section h2 {
            font-size: 2rem;
            margin-bottom: 15px;
        }

        .cta-section p {
            color: rgba(255,255,255,0.7);
            margin-bottom: 25px;
        }
</style>

<div class="services-hero">
    <h1><i class="fa-solid fa-scissors"></i> Нашите Услуги</h1>
    <p>Изберете услуга и запазете час онлайн за минути.</p>
</div>

<div class="services-grid">
    @foreach (var s in Model)
    {
        <div class="service-card">
            @if (!string.IsNullOrEmpty(s.ImageUrl))
            {
                <img class="service-img" src="@s.ImageUrl" alt="@s.Name" />
            }
            else
            {
                <div class="service-img-placeholder">✂️</div>
            }
            <div class="service-body">
                <h3>@s.Name</h3>
                <p>@s.Description</p>
                <div class="service-meta">
                    <div class="service-price">@((s.Price / 1.95583m).ToString("0.00")) € <span>/ @s.Price.ToString("0.00") лв.</span></div>
                    <div class="service-duration">@s.DurationMinutes мин.</div>
                </div>
                <a href="@Url.Action("BookAppointment", "Home")" class="book-btn">Запази час</a>
            </div>
        </div>
    }
</div>

<div class="cta-section">
    <h2>Готов за нова визия?</h2>
    <p>Резервирай своя час сега и получи обслужване от нашите майстори.</p>
    <a href="@Url.Action("BookAppointment", "Home")" class="btn-gold">Запази час</a>
</div>