@{
    ViewData["Title"] = "Регистрация";
}

<style>
    .auth-page {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .auth-card {
        background: rgba(255,255,255,0.08);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.15);
        border-radius: 24px;
        padding: 50px 45px;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 25px 60px rgba(0,0,0,0.3);
        animation: fadeInUp 0.6s ease;
    }

        .auth-card h2 {
            font-size: 2rem;
            font-weight: 800;
            text-align: center;
            margin-bottom: 8px;
        }

    .subtitle {
        text-align: center;
        color: rgba(255,255,255,0.6);
        margin-bottom: 35px;
        font-size: 0.95rem;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: rgba(255,255,255,0.8);
            font-size: 0.9rem;
            font-weight: 500;
        }

        .form-group input {
            width: 100%;
            padding: 14px 18px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.15);
            background: rgba(255,255,255,0.07);
            color: #fff;
            font-size: 1rem;
            outline: none;
            box-sizing: border-box;
            transition: 0.3s;
        }

            .form-group input:focus {
                border-color: #ff416c;
                box-shadow: 0 0 15px rgba(255,65,108,0.3);
            }

            .form-group input::placeholder {
                color: rgba(255,255,255,0.3);
            }

    .btn-auth {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(45deg, #ff416c, #ff4b2b);
        color: #fff;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-auth:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(255,65,108,0.5);
        }

    .error-msg {
        background: rgba(255,65,108,0.15);
        border: 1px solid rgba(255,65,108,0.4);
        border-radius: 10px;
        padding: 12px 16px;
        color: #ff8a9e;
        margin-bottom: 20px;
        font-size: 0.9rem;
    }

    .auth-footer {
        text-align: center;
        margin-top: 25px;
        color: rgba(255,255,255,0.5);
        font-size: 0.9rem;
    }

        .auth-footer a {
            color: #ff416c;
            text-decoration: none;
            font-weight: 600;
        }

    .hint {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.4);
        margin-top: 5px;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="auth-page">
    <div class="auth-card">
        <h2>✂️ Регистрация</h2>
        <p class="subtitle">Създай безплатен профил</p>

        @if (ViewBag.Error != null)
        {
            <div class="error-msg">@ViewBag.Error</div>
        }

        <form method="post" action="@Url.Action("Register", "Account")">
            <div class="form-group">
                <label>Пълно име</label>
                <input type="text" name="fullName" placeholder="Иван Иванов" required />
            </div>
            <div class="form-group">
                <label>Имейл</label>
                <input type="email" name="email" placeholder="example@mail.com" required />
            </div>
            <div class="form-group">
                <label>Парола</label>
                <input type="password" name="password" placeholder="Мин. 6 символа" required />
                <div class="hint">Минимум 6 символа</div>
            </div>
            <div class="form-group">
                <label>Потвърди парола</label>
                <input type="password" name="confirmPassword" placeholder="Повтори паролата" required />
            </div>
            <button type="submit" class="btn-auth">Регистрирай се</button>
        </form>

        <div class="auth-footer">
            Вече имаш профил? <a href="@Url.Action("Login", "Account")">Влез</a>
        </div>
    </div>
</div>