@{
    ViewData["Title"] = "Регистрация";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet" />

<style>
    .auth-wrapper {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 50px 20px;
    }

    .auth-box {
        background: #111;
        border: 1px solid rgba(200,169,110,0.25);
        border-radius: 20px;
        padding: 50px 45px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 30px 70px rgba(0,0,0,0.5), 0 0 40px rgba(200,169,110,0.05);
        animation: fadeUp 0.6s ease;
    }

    .auth-logo {
        text-align: center;
        margin-bottom: 30px;
    }

        .auth-logo .scissors {
            font-size: 2.2rem;
            display: block;
            margin-bottom: 10px;
        }

        .auth-logo h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.9rem;
            color: #c8a96e;
            margin: 0 0 5px;
            letter-spacing: 0.03em;
        }

        .auth-logo p {
            color: rgba(255,255,255,0.4);
            font-size: 0.9rem;
        }

    .divider {
        border: none;
        border-top: 1px solid rgba(200,169,110,0.15);
        margin: 25px 0;
    }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            color: rgba(200,169,110,0.8);
            font-size: 0.85rem;
            font-weight: 500;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

            .form-group label .req {
                color: #c8a96e;
            }

        .form-group input {
            width: 100%;
            padding: 13px 16px;
            border-radius: 10px;
            border: 1px solid rgba(200,169,110,0.2);
            background: rgba(200,169,110,0.05);
            color: #f0e6d3;
            font-size: 0.97rem;
            outline: none;
            box-sizing: border-box;
            transition: 0.3s;
        }

            .form-group input:focus {
                border-color: #c8a96e;
                background: rgba(200,169,110,0.08);
                box-shadow: 0 0 14px rgba(200,169,110,0.15);
            }

            .form-group input::placeholder {
                color: rgba(255,255,255,0.2);
            }

    .hint {
        font-size: 0.78rem;
        color: rgba(255,255,255,0.3);
        margin-top: 5px;
    }

    .error-msg {
        background: rgba(200,50,50,0.12);
        border: 1px solid rgba(200,50,50,0.35);
        border-radius: 10px;
        padding: 12px 16px;
        color: #e07070;
        margin-bottom: 20px;
        font-size: 0.9rem;
    }

    .btn-register {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #c8a96e, #a07840);
        color: #111;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        cursor: pointer;
        transition: 0.3s;
        margin-top: 8px;
    }

        .btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(200,169,110,0.35);
            background: linear-gradient(135deg, #d9bb80, #b08850);
        }

    .auth-footer {
        text-align: center;
        margin-top: 22px;
        color: rgba(255,255,255,0.35);
        font-size: 0.88rem;
    }

        .auth-footer a {
            color: #c8a96e;
            text-decoration: none;
            font-weight: 600;
        }

            .auth-footer a:hover {
                color: #d9bb80;
                text-decoration: underline;
            }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="auth-wrapper">
    <div class="auth-box">
        <div class="auth-logo">
            <span class="scissors">✂️</span>
            <h2>NaskoCuts</h2>
            <p>Създай безплатен профил</p>
        </div>

        <hr class="divider" />

        @if (ViewBag.Error != null)
        {
            <div class="error-msg">@ViewBag.Error</div>
        }

        <form method="post" action="@Url.Action("Register", "Account")" autocomplete="off">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Пълно име <span class="req">*</span></label>
                <input type="text" name="fullName" placeholder="Иван Иванов" required />
            </div>
            <div class="form-group">
                <label>Имейл <span class="req">*</span></label>
                <input type="email" name="email" placeholder="example@mail.com" required />
            </div>
            <div class="form-group">
                <label>Телефон</label>
                <input type="tel" name="phone" placeholder="+359 88 888 8888" />
            </div>
            <div class="form-group">
                <label>Парола <span class="req">*</span></label>
                <input type="password" name="password" placeholder="Минимум 6 символа" required />
                <div class="hint">Минимум 6 символа</div>
            </div>
            <div class="form-group">
                <label>Потвърди парола <span class="req">*</span></label>
                <input type="password" name="confirmPassword" placeholder="Повтори паролата" required />
            </div>
            <button type="submit" class="btn-register">Регистрирай се</button>
        </form>

        <div class="auth-footer">
            Вече имаш профил? <a href="@Url.Action("Login", "Account")">Влез тук</a>
        </div>
    </div>
</div> 